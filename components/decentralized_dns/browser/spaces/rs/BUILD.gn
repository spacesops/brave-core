import("//build/rust/rust_static_library.gni")

rust_static_library("rust_lib") {
  visibility = [ "//brave/components/decentralized_dns/browser/spaces:*" ]
  crate_name = "spaces_cxx"
  crate_root = "src/lib.rs"
  allow_unsafe = true
  sources = [ "src/lib.rs" ]
  cxx_bindings = [ "src/lib.rs" ]

  public_deps = [ ":shim" ]

  deps = [
    "//brave/third_party/rust/fabric_resolver/v0_2:lib",
    "//brave/third_party/rust/futures/v0_3:lib",
    "//brave/third_party/rust/libveritas/v0_4:lib",
  ]
}

source_set("shim") {
  visibility = [ ":*" ]
  sources = [ "src/shim.h" ]
  public_deps = [ "//build/rust:cxx_cppdeps" ]
}
